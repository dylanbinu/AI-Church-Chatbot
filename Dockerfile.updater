# Updater image — weekly page download and search-index build. No browser.
FROM public.ecr.aws/lambda/python:3.12

COPY requirements-updater.txt requirements-chat.txt ./
RUN pip install --no-cache-dir -r requirements-updater.txt

COPY code/ ${LAMBDA_TASK_ROOT}/code/

ENV PYTHONPATH=${LAMBDA_TASK_ROOT}/code
ENV TIKTOKEN_CACHE_DIR=/tmp

WORKDIR ${LAMBDA_TASK_ROOT}/code

CMD ["updater.handler"]
