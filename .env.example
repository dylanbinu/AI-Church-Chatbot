# Required for chat + ingestion
OPENAI_API_KEY=

# Multi-tenant defaults
CHURCH_ID=heritage
S3_BUCKET_NAME=

# Optional: comma-separated API keys for /chat (empty = auth disabled)
API_KEYS=

# Optional: override CORS (comma-separated). Falls back to church registry allowed_origins.
ALLOWED_ORIGINS=

# Updater: chat Lambda name to bump DATA_VERSION after a successful publish
CHAT_FUNCTION_NAME=

# Logging / local server
LOG_LEVEL=INFO
PORT=8004

# Scrape quality gates (updater)
MAX_PAGES=400
MIN_PAGES=25
REGRESSION_RATIO=0.7
